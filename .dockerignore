# ═══════════════════════════════════════════════════════════════════
# PlenumNET .dockerignore — keep only dist/ and runtime essentials
# ═══════════════════════════════════════════════════════════════════

# Rust build artifacts (5+ GB)
target/
**/target/
ternary-math/target/
libternary/target/
services/inter-cube/target/

# Rust source crates (not needed at web runtime)
ternary-math/
libternary/
libternary-improvements/
services/
ninja-exec/
plenumlan/
tools/
cli/
benchmarks/
contracts/
XPlenum/
sign-here/

# Kernel source (317 MB)
src/

# Git and CI (647 MB)
.git/
.github/

# Dev tooling and caches (446 MB+)
.local/
.cache/
.canvas/
.pythonlibs/
.agents/
artifacts/

# Attached assets
attached_assets/

# Documentation, config, and non-runtime dirs
docs/
salvi_docs/
references/
deployments/
kong/
keys/
github-push/
assets/
installer-output/
plenumnet-data/

# Test files
tests/

# All markdown, text, log files
*.md
*.txt
*.log

# Config files not needed at runtime
.replit
replit.nix
.gitignore
.gitattributes
Dockerfile
.dockerignore
Cargo.toml
Cargo.lock
drizzle.config.ts
tsconfig.json
tailwind.config.ts
postcss.config.js
vite.config.ts
theme.json
components.json
package-lock.json
docker-compose*.yml

# Large media / build outputs
*.mp4
*.mov
*.zip
*.tar.gz
*.msi
*.wasm

# Preserve dist/ and server/crypto/ for runtime
!dist/
!dist/**
!server/crypto/sponge-native.node
