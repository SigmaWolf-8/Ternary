# ═══════════════════════════════════════════════════════════════════
# PlenumNET .dockerignore — keep only dist/ and runtime essentials
# ═══════════════════════════════════════════════════════════════════

# Rust build artifacts (3.9 GB)
target/
ternary-math/target/
libternary/target/
services/inter-cube/target/

# Rust source crates (not needed at web runtime)
ternary-math/
libternary/
libternary-improvements/
services/
ninja-exec/
plenumlan/
tools/
cli/
benchmarks/
contracts/
XPlenum/
sign-here/

# Kernel source (317 MB)
src/

# Frontend/backend source (compiled into dist/)
client/
server/
shared/
script/
scripts/

# Node modules (825 MB — rebuilt in deploy if needed)
node_modules/

# Git and CI (574 MB)
.git/
.github/

# Dev tooling and caches
.local/
.cache/
.canvas/
.pythonlibs/
.agents/
artifacts/

# Attached assets
attached_assets/

# Documentation and config
docs/
salvi_docs/
references/
deployments/
kong/
keys/
github-push/
assets/

# Test files
tests/

# All markdown, text, log files
*.md
*.txt
*.log

# TypeScript source files (compiled into dist/)
*.ts
*.tsx
!dist/**

# Config files not needed at runtime
.replit
replit.nix
.gitignore
.gitattributes
Dockerfile
.dockerignore
Cargo.toml
Cargo.lock
drizzle.config.ts
tsconfig.json
tailwind.config.ts
postcss.config.js
vite.config.ts
theme.json
components.json
package-lock.json
docker-compose*.yml

# Large media files
*.mp4
*.mov
*.zip
*.tar.gz
*.msi
installer-output/
plenumnet-data/
