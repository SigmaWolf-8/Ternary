[tasks]
bmc          # Bounded Model Checking (fast failure detection)
prove        # K-induction proof (full verification)
cover        # Cover mode (reachability analysis)

[options]
bmc:   mode bmc
bmc:   depth 30

prove: mode prove
prove: depth 40

cover: mode cover
cover: depth 30

[engines]
smtbmc boolector

[script]
read -formal -DFORMAL ../xplenum_pkg.vh
read -formal -DFORMAL ../xplenum_mask_unit.v
read -formal -DFORMAL ../xplenum_domain_unit.v
read -formal -DFORMAL ../xplenum_cap_unit.v
read -formal -DFORMAL ../xplenum_trit_unit.v
read -formal -DFORMAL ../xplenum_top.v
read -formal -DFORMAL xplenum_formal_props.v
prep -top xplenum_top

[files]
../xplenum_pkg.vh
../xplenum_mask_unit.v
../xplenum_domain_unit.v
../xplenum_cap_unit.v
../xplenum_trit_unit.v
../xplenum_top.v
xplenum_formal_props.v
