modules = ["nodejs-20", "web", "postgresql-16", "python-3.11"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["cargo", "clippy", "freetype", "jq", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "rsync", "rustc", "tcl", "tk", "unzip", "verilog", "zlib", "rustfmt"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8181
externalPort = 3000

[[ports]]
localPort = 23636
externalPort = 4200

[[ports]]
localPort = 23637
externalPort = 3003

[[ports]]
localPort = 23638
externalPort = 5000

[env]
PORT = "5000"

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "NODE_OPTIONS=--max-old-space-size=384 node dist/index.mjs"]
build = ["bash", "-c", "bash scripts/deploy-clean.sh && npm run build && npm prune --production"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'trap \"\" HUP; NODE_OPTIONS=--max-old-space-size=384 npm run dev; wait'"
waitForPort = 5000

[agent]
integrations = ["javascript_log_in_with_replit:2.0.0", "javascript_openai_ai_integrations:2.0.0"]

[userenv]

[userenv.shared]
KONG_KONNECT_TOKEN = "kpat_wNYrrD2A47tLxKMUU1O4soQp5gesU03f1XSLs7TJPbIhBzeiA"
GIT_COMMIT = "2cf6ba2"
TSA_NOTIFICATION_PHASE = "3"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
