{
  "manifest_version": 3,
  "name": "PlenumNET TDNS Scanner",
  "version": "1.0.9",
  "description": "54-trit dual-layer ontological addressing. Classification + Identity Anchor, five GF(3) scores, security audit, and tracker detection for any URL \u2014 in under 10 seconds.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PlenumNET TDNS Scanner",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://plenumnet.replit.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dimensions.json",
        "report.html",
        "report.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}