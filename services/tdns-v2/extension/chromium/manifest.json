{
  "manifest_version": 3,
  "name": "PlenumNET TDNS Resolver",
  "version": "2.3.4",
  "description": "Resolve .plm addresses via the PlenumNET Ternary Domain Name System",
  "author": "Capomastro Holdings Ltd.",
  "permissions": ["declarativeNetRequest", "webNavigation", "storage"],
  "host_permissions": ["*://*.plm/*", "https://plenumnet.replit.app/*", "*://*.bing.com/*", "*://*.google.com/*", "*://*.duckduckgo.com/*", "*://*.yahoo.com/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "omnibox": {
    "keyword": "plm"
  },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "plm_redirect",
      "enabled": true,
      "path": "rules.json"
    }]
  }
}
